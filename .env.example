# 建议设置一个随机长字符串；设置后访问网页和订阅都必须带 ?token=...
ACCESS_TOKEN=change-me-to-a-long-random-token

# 你的 subconverter 地址，不要带 /sub
SUBAPI=https://subconverter.example.com

# 可选：默认远程 .ini URL
SUBCONFIG=

# 可选：不填则继续读取本仓库 GitHub Raw 默认地址
BEST_IP_CSV=
FIXED_ADDRESSES_URL=
# 优选节点上限：合并保留/订阅输出默认条数，不设置则为 30
BEST_IP_MAX=
# 测速地址：默认使用 300MB 公益文件（官方 speed.cloudflare.com 过大约 95MB 会 403）
BEST_IP_TEST_URL=
# 设为 1 时用 HTTPing 初筛（公益文件未缓存，延迟会虚高，默认关闭）
BEST_IP_HTTPING=
